<UserControl x:Class="RentACar.Wpf.Views.RentalPageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Filters -->
            <RowDefinition Height="*"/>
            <!-- List -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <!-- Filters + List -->
            <ColumnDefinition Width="*"/>
            <!-- Details -->
        </Grid.ColumnDefinitions>

        <!-- Филтри -->
        <StackPanel Grid.Row="0" Grid.Column="0"
                    Orientation="Horizontal"
                    Margin="0,0,0,10"
                    VerticalAlignment="Top">

            <TextBlock Text="Status:" Margin="0,0,5,0"/>
            <TextBox Width="100" Margin="0,0,10,0"
                     Text="{Binding Search.Status, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Pickup from:" Margin="0,0,5,0"/>
            <DatePicker Width="120" Margin="0,0,10,0"
                        SelectedDate="{Binding Search.PickupFrom, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Pickup to:" Margin="0,0,5,0"/>
            <DatePicker Width="120" Margin="0,0,10,0"
                        SelectedDate="{Binding Search.PickupTo, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Customer:" Margin="0,0,5,0"/>
            <TextBox Width="150" Margin="0,0,10,0"
                     Text="{Binding Search.CustomerNameContains, UpdateSourceTrigger=PropertyChanged}"/>

            <Button Content="Search"
                    Padding="10,2"
                    Click="SearchButton_Click"/>
        </StackPanel>

        <!-- Списък с Rentals -->
        <DataGrid Grid.Row="1" Grid.Column="0"
                  ItemsSource="{Binding List.Rentals}"
                  SelectedItem="{Binding List.SelectedRental, Mode=TwoWay}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Car"
                                    Binding="{Binding Car.RegistrationNumber}"/>
                <DataGridTextColumn Header="Customer"
                                    Binding="{Binding Customer.FullName}"/>
                <DataGridTextColumn Header="Pickup"
                                    Binding="{Binding PickupDateTime}"/>
                <DataGridTextColumn Header="Dropoff"
                                    Binding="{Binding DropoffDateTime}"/>
                <DataGridTextColumn Header="Status"
                                    Binding="{Binding Status}"/>
                <DataGridTextColumn Header="Total price"
                                    Binding="{Binding TotalPrice}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Детайли за редакция на Rental -->
        <StackPanel Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="1"
            Margin="10,0,0,0">
            <TextBlock Text="Rental editor"
               FontWeight="Bold"
               Margin="0,0,0,10" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="New rental"
                Width="90"
                Margin="0,0,5,0"
                Click="NewRentalButton_Click" />
                <Button Content="Edit selected"
                Width="100"
                Margin="0,0,5,0"
                Click="EditSelectedButton_Click" />
                <Button Content="Save"
                Margin="0,0,5,0"
                Width="70"
                Click="SaveButton_Click" />
            </StackPanel>

            <TextBlock Text="Pickup:" />
            <DatePicker SelectedDate="{Binding Edit.Current.PickupDateTime, Mode=TwoWay}" />

            <TextBlock Text="Dropoff:" Margin="0,5,0,0" />
            <DatePicker SelectedDate="{Binding Edit.Current.DropoffDateTime, Mode=TwoWay}" />

            <TextBlock Text="Total price:" Margin="0,5,0,0" />
            <TextBox Text="{Binding Edit.Current.TotalPrice, Mode=OneWay}" IsReadOnly="True" />

            <TextBlock Text="Status:" Margin="0,5,0,0" />
            <TextBox Text="{Binding Edit.Current.Status, Mode=TwoWay}" />

            <!-- Car избор -->
            <TextBlock Text="Car:" />
            <ComboBox ItemsSource="{Binding Edit.Cars}"
               SelectedItem="{Binding Edit.SelectedCar, Mode=TwoWay}"
               DisplayMemberPath="RegistrationNumber"
               Width="150"
               Margin="0,0,0,5" />

            <!-- Customer избор -->
            <TextBlock Text="Customer:" Margin="0,5,0,0" />
            <ComboBox ItemsSource="{Binding Edit.Customers}"
               SelectedItem="{Binding Edit.SelectedCustomer, Mode=TwoWay}"
               DisplayMemberPath="DrivingLicenseNumber"
               Width="150"
               Margin="0,0,0,5" />


        </StackPanel>
    </Grid>
</UserControl> 
