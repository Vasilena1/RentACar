<Window x:Class="RentACar.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RentACar.Wpf.Views"
        xmlns:vm="clr-namespace:RentACar.ViewModel.ViewModels;assembly=RentACar.ViewModel"
        Title="Rent a Car – WPF"
        Height="600"
        Width="1400">

    <Window.Resources>

        <!-- Когато Content е CarPageViewModel, показваме CarPageView -->
        <DataTemplate DataType="{x:Type vm:CarPageViewModel}">
            <views:CarPageView />
        </DataTemplate>

        <!-- Когато Content е RentalPageViewModel, показваме RentalPageView -->
        <DataTemplate DataType="{x:Type vm:RentalPageViewModel}">
            <views:RentalPageView />
        </DataTemplate>

        <!-- Когато Content е CustomerPageViewModel, показваме CustomerPageView -->
        <DataTemplate DataType="{x:Type vm:CustomerPageViewModel}">
            <views:CustomerPageView />
        </DataTemplate>

    </Window.Resources>

    <DockPanel>

        <!-- Навигационни бутони -->
        <StackPanel DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Margin="5">
            <Button Content="Cars"
                    Margin="0,0,5,0"
                    Command="{Binding ShowCarsCommand}" />
            <Button Content="Rentals"
                    Margin="0,0,5,0"
                    Command="{Binding ShowRentalsCommand}" />
            <Button Content="Customers"
                    Margin="0,0,250,0"
                    Command="{Binding ShowCustomersCommand}" />

            <TextBlock Text="Database:"
                   VerticalAlignment="Center"
                   Margin="0,0,5,0"/>
            <ComboBox x:Name="DbProviderCombo"
                  Width="120"
                  SelectionChanged="DbProviderCombo_SelectionChanged">
                <ComboBoxItem Content="SQLite" Tag="Sqlite" IsSelected="True"/>
                <ComboBoxItem Content="SQL Server" Tag="SqlServer"/>
            </ComboBox>
        </StackPanel>

        <!-- Тук се показва активната страница -->
        <ContentControl Margin="5"
                        Content="{Binding CurrentPageViewModel}" />
    </DockPanel>
    
</Window>
